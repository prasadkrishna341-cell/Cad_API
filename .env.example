# ---------------------------------------------------------------------------
# Zerodha Kite Connect credentials
# Create an app at https://developers.kite.trade/apps to get these.
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
# ---------------------------------------------------------------------------
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Redirect URL configured on your Kite app. The login flow reads the
# `request_token` query parameter back off this URL.
KITE_REDIRECT_URL=http://127.0.0.1:5000/callback

# ---------------------------------------------------------------------------
# Trading mode.  "paper"  -> simulated fills, no real orders (DEFAULT)
#                "live"   -> REAL money, real orders on your Kite account
# Live mode additionally requires KITE_LIVE_CONFIRM=I_UNDERSTAND_THE_RISK.
# ---------------------------------------------------------------------------
KITE_TRADING_MODE=paper
KITE_LIVE_CONFIRM=

# ---------------------------------------------------------------------------
# Risk limits. These are hard stops enforced before every order.
# ---------------------------------------------------------------------------
# Notional capital the algo is allowed to deploy.
KITE_CAPITAL=100000
# Fraction of capital risked on a single trade (0.01 = 1%).
KITE_RISK_PER_TRADE=0.01
# Max notional exposure in a single instrument, as a fraction of capital.
KITE_MAX_POSITION_PCT=0.25
# Stop trading for the day once realised+unrealised loss exceeds this fraction.
KITE_MAX_DAILY_LOSS_PCT=0.03
# Maximum simultaneous open positions.
KITE_MAX_OPEN_POSITIONS=5
# Maximum number of entries per day across all strategies.
KITE_MAX_TRADES_PER_DAY=20

# ---------------------------------------------------------------------------
# Session / market timing (IST). Intraday positions are squared off at
# KITE_SQUARE_OFF_TIME regardless of strategy state.
# ---------------------------------------------------------------------------
KITE_TRADE_START_TIME=09:20
KITE_TRADE_END_TIME=15:00
KITE_SQUARE_OFF_TIME=15:15

# Default product: MIS (intraday, auto square-off) / CNC (delivery) / NRML
KITE_DEFAULT_PRODUCT=MIS

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
KITE_STATE_DIR=.kitealgo
KITE_LOG_LEVEL=INFO
